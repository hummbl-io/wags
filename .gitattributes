# Canonical fleet .gitattributes — normalizes line endings to LF.
# All text files use LF in the repo; editors convert on checkout as needed.
* text=auto eol=lf

# Shell scripts must keep LF for git-bash and WSL compatibility.
*.sh text eol=lf
*.bash text eol=lf

# PowerShell scripts: LF is safe and avoids CRLF noise on cross-platform work.
*.ps1 text eol=lf
*.psm1 text eol=lf

# Python: LF for consistent hashing and cross-platform behavior.
*.py text eol=lf

# Web/config files: LF standard.
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.svg binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.bin binary
*.dat binary
*.db binary
*.sqlite binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
